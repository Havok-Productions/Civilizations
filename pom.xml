<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.hearth</groupId>
    <artifactId>hearth</artifactId>
    <version>1.3.2</version>
    <packaging>jar</packaging>

    <name>Hearth</name>
    <description>AI-assisted villager collective: builds walls, digs mines, lights up, gathers, and sleeps.</description>

    <properties>
        <!-- Folia 26.x (latest) is built against Java 25 bytecode; a Java 25 JDK is required. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            Hearth targets the LATEST stable Folia API (26.1.2, the
            stable-suffixed <release> in PaperMC maven metadata). A jar built
            against 26.1 with api-version '26.1' loads on BOTH the 26.1 stable
            line and the newer 26.2 beta line (newer servers accept plugins
            whose api-version is at or below their own).

            To build against the 26.2 beta API instead, set the version to
            26.2.build.7-beta and api-version in plugin.yml to '26.2'.
        -->
        <dependency>
            <groupId>dev.folia</groupId>
            <artifactId>folia-api</artifactId>
            <version>26.1.2.build.8-stable</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Hearth-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
